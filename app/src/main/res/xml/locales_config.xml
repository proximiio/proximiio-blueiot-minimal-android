<?xml version="1.0" encoding="utf-8"?>
<!--
  The languages the app's own text is written in. The iOS app is localized in English
  only, and so is this one. The first entry is the app's default language:
  `ProximiioLanguage.preferred(context)` returns it when no device language is listed
  here, so the map's Automatic language is English.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
</locale-config>
