<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing this app stores is worth restoring onto another phone: the wristband id
  belongs to a band somebody was handed, and a visit is an afternoon. Both are
  excluded from cloud backup and from device transfer, which is also why there is
  no `allowBackup` flag on the application — that one is deprecated from Android 12.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="BlueiotMinimal.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="BlueiotMinimal.xml" />
    </device-transfer>
</data-extraction-rules>
